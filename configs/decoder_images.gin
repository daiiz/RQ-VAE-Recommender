import data.processed

train.iterations=15000
train.batch_size=64
train.vae_input_dim=768
train.vae_hidden_dims=[512, 256, 128]
train.vae_embed_dim=32
train.vae_n_cat_feats=0
train.vae_codebook_size=128
train.wandb_logging=True
train.pretrained_rqvae_path="out/rqvae/images/checkpoint_29999.pt"
train.save_dir_root="out/decoder/images/"
