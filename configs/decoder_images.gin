train.dataset=%data.processed.RecDataset.IMAGES
train.force_dataset_process=False
train.full_eval_every=3000
train.partial_eval_every=3000
train.attn_dropout=0.1
train.attn_heads=4
train.attn_embed_dim=256
train.attn_layers=6
train.decoder_embed_dim=64
